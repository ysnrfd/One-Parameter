{
  "types": [
    {
      "id": "hf.config",
      "title": "HF model configuration",
      "category": "Transformers \u00b7 Architecture",
      "description": "Create an offline AutoConfig recipe. No model download or remote code.",
      "inputs": [
        {
          "name": "values",
          "type": "object",
          "required": true,
          "default": {
            "vocab_size": 16,
            "n_positions": 32,
            "n_ctx": 32,
            "n_embd": 16,
            "n_layer": 1,
            "n_head": 2,
            "bos_token_id": 2,
            "eos_token_id": 3,
            "pad_token_id": 0
          }
        }
      ],
      "outputs": [
        {
          "name": "config",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "model_type",
          "type": "string",
          "default": "gpt2"
        }
      ]
    },
    {
      "id": "hf.model",
      "title": "HF AutoModel",
      "category": "Transformers \u00b7 Architecture",
      "description": "Instantiate an actual supported HF model from config after a meta-device parameter budget check.",
      "inputs": [
        {
          "name": "config",
          "type": "object",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "task",
          "type": "string",
          "default": "causal-lm",
          "options": [
            "base",
            "causal-lm",
            "seq2seq-lm",
            "sequence-classification",
            "token-classification",
            "question-answering",
            "masked-lm",
            "image-classification",
            "audio-classification"
          ]
        },
        {
          "name": "seed",
          "type": "integer",
          "default": 42,
          "min": 0,
          "max": 2147483647
        }
      ]
    },
    {
      "id": "hf.pretrained",
      "title": "Cached HF pretrained model",
      "category": "Transformers \u00b7 Architecture",
      "description": "Load actual cached safetensors weights by public Hub repository and pinned commit. No downloads, arbitrary paths, remote code or pickle.",
      "inputs": [],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "repo_id",
          "type": "string",
          "default": "hf-internal-testing/tiny-random-gpt2"
        },
        {
          "name": "revision",
          "type": "string",
          "default": ""
        },
        {
          "name": "task",
          "type": "string",
          "default": "causal-lm",
          "options": [
            "base",
            "causal-lm",
            "seq2seq-lm",
            "sequence-classification",
            "token-classification",
            "question-answering",
            "masked-lm",
            "image-classification",
            "audio-classification"
          ]
        }
      ]
    },
    {
      "id": "hf.auto_tokenizer",
      "title": "Cached HF AutoTokenizer",
      "category": "Transformers \u00b7 Data",
      "description": "Load a matching cached fast tokenizer by repository and pinned Hub commit. Never imports remote tokenizer code.",
      "inputs": [],
      "outputs": [
        {
          "name": "tokenizer",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "repo_id",
          "type": "string",
          "default": "hf-internal-testing/tiny-random-gpt2"
        },
        {
          "name": "revision",
          "type": "string",
          "default": ""
        }
      ]
    },
    {
      "id": "hf.tokenizer",
      "title": "Local HF fast tokenizer",
      "category": "Transformers \u00b7 Data",
      "description": "Build a real offline WordLevel PreTrainedTokenizerFast from an editable vocabulary.",
      "inputs": [
        {
          "name": "vocab",
          "type": "object",
          "required": true,
          "default": {
            "[PAD]": 0,
            "[UNK]": 1,
            "[BOS]": 2,
            "[EOS]": 3,
            "hello": 4,
            "world": 5
          }
        }
      ],
      "outputs": [
        {
          "name": "tokenizer",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "lowercase",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "id": "hf.tokenize",
      "title": "Tokenize text",
      "category": "Transformers \u00b7 Data",
      "description": "Tokenize and pad text; causal labels mask padding with -100.",
      "inputs": [
        {
          "name": "tokenizer",
          "type": "object",
          "required": true
        },
        {
          "name": "texts",
          "type": "array",
          "required": true,
          "default": [
            "hello world",
            "hello"
          ]
        }
      ],
      "outputs": [
        {
          "name": "data",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "max_length",
          "type": "integer",
          "default": 32,
          "min": 1,
          "max": 512
        },
        {
          "name": "labels",
          "type": "string",
          "default": "causal",
          "options": [
            "none",
            "causal"
          ]
        }
      ]
    },
    {
      "id": "hf.data",
      "title": "Tensor dataset",
      "category": "Transformers \u00b7 Data",
      "description": "Finite named tensor batches: x/labels for custom models or input_ids/attention_mask/labels for HF.",
      "inputs": [
        {
          "name": "fields",
          "type": "object",
          "required": true,
          "default": {
            "x": [
              [
                -1
              ],
              [
                0
              ],
              [
                1
              ]
            ],
            "labels": [
              [
                -2
              ],
              [
                0
              ],
              [
                2
              ]
            ]
          }
        }
      ],
      "outputs": [
        {
          "name": "data",
          "type": "object",
          "required": true
        }
      ],
      "parameters": []
    },
    {
      "id": "hf.layer",
      "title": "Layer recipe",
      "category": "Transformers \u00b7 Architecture",
      "description": "A declarative PyTorch layer. Connect recipes into Compose layers / Sequential / custom forward.",
      "inputs": [
        {
          "name": "recipe",
          "type": "object",
          "required": true,
          "default": {
            "type": "Linear",
            "in_features": 1,
            "out_features": 8
          }
        }
      ],
      "outputs": [
        {
          "name": "layer",
          "type": "object",
          "required": true
        }
      ],
      "parameters": []
    },
    {
      "id": "hf.linear",
      "title": "Linear",
      "category": "Transformers \u00b7 Architecture",
      "description": "Trainable dense projection with arbitrary bounded input/output width.",
      "inputs": [],
      "outputs": [
        {
          "name": "layer",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "in_features",
          "type": "integer",
          "default": 1,
          "min": 1
        },
        {
          "name": "out_features",
          "type": "integer",
          "default": 8,
          "min": 1
        },
        {
          "name": "bias",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "id": "hf.embedding",
      "title": "Embedding",
      "category": "Transformers \u00b7 Architecture",
      "description": "A trainable token embedding table.",
      "inputs": [],
      "outputs": [
        {
          "name": "layer",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "num_embeddings",
          "type": "integer",
          "default": 16,
          "min": 1
        },
        {
          "name": "embedding_dim",
          "type": "integer",
          "default": 8,
          "min": 1
        }
      ]
    },
    {
      "id": "hf.rmsnorm",
      "title": "RMSNorm",
      "category": "Transformers \u00b7 Architecture",
      "description": "Actual torch.nn.RMSNorm. Normalization connects to layer outputs; optimizers bind the complete model.",
      "inputs": [],
      "outputs": [
        {
          "name": "layer",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "normalized_shape",
          "type": "integer",
          "default": 8,
          "min": 1
        },
        {
          "name": "eps",
          "type": "number",
          "default": 1e-06
        }
      ]
    },
    {
      "id": "hf.layernorm",
      "title": "LayerNorm",
      "category": "Transformers \u00b7 Architecture",
      "description": "Actual torch.nn.LayerNorm.",
      "inputs": [],
      "outputs": [
        {
          "name": "layer",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "normalized_shape",
          "type": "integer",
          "default": 8,
          "min": 1
        },
        {
          "name": "eps",
          "type": "number",
          "default": 1e-05
        }
      ]
    },
    {
      "id": "hf.activation",
      "title": "Activation",
      "category": "Transformers \u00b7 Architecture",
      "description": "A stateless tensor activation.",
      "inputs": [],
      "outputs": [
        {
          "name": "layer",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "default": "GELU",
          "options": [
            "GELU",
            "ReLU",
            "SiLU",
            "Tanh",
            "Sigmoid",
            "Identity"
          ]
        }
      ]
    },
    {
      "id": "hf.attention",
      "title": "Self attention",
      "category": "Transformers \u00b7 Architecture",
      "description": "Trainable batch-first multi-head self attention with optional causal masking.",
      "inputs": [],
      "outputs": [
        {
          "name": "layer",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "embed_dim",
          "type": "integer",
          "default": 8,
          "min": 1
        },
        {
          "name": "num_heads",
          "type": "integer",
          "default": 2,
          "min": 1
        },
        {
          "name": "dropout",
          "type": "number",
          "default": 0
        },
        {
          "name": "causal",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "id": "hf.compose",
      "title": "Compose layers",
      "category": "Transformers \u00b7 Architecture",
      "description": "Join two layer recipes or composed layer lists. Connect the layers output to Sequential.",
      "inputs": [
        {
          "name": "a",
          "type": "any",
          "required": true,
          "default": {}
        },
        {
          "name": "b",
          "type": "any",
          "required": true,
          "default": {}
        }
      ],
      "outputs": [
        {
          "name": "layers",
          "type": "array",
          "required": true
        }
      ],
      "parameters": []
    },
    {
      "id": "hf.stack",
      "title": "Append layer",
      "category": "Transformers \u00b7 Architecture",
      "description": "Append an individual layer to a layer list.",
      "inputs": [
        {
          "name": "layers",
          "type": "array",
          "required": true,
          "default": []
        },
        {
          "name": "layer",
          "type": "object",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "layers",
          "type": "array",
          "required": true
        }
      ],
      "parameters": []
    },
    {
      "id": "hf.sequential",
      "title": "Sequential model",
      "category": "Transformers \u00b7 Architecture",
      "description": "Instantiate a real multi-parameter PyTorch architecture from ordered layer recipes.",
      "inputs": [
        {
          "name": "layers",
          "type": "array",
          "required": true,
          "default": [
            {
              "type": "Linear",
              "in_features": 1,
              "out_features": 8,
              "bias": true
            },
            {
              "type": "RMSNorm",
              "normalized_shape": 8,
              "eps": 1e-06
            },
            {
              "type": "GELU"
            },
            {
              "type": "Linear",
              "in_features": 8,
              "out_features": 1,
              "bias": true
            }
          ]
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "seed",
          "type": "integer",
          "default": 42,
          "min": 0,
          "max": 2147483647
        }
      ]
    },
    {
      "id": "hf.custom",
      "title": "Custom tensor forward",
      "category": "Transformers \u00b7 Code",
      "description": "Editable restricted Python tensor expressions and named trainable layers. No imports, attributes, loops, eval or exec.",
      "inputs": [
        {
          "name": "layers",
          "type": "object",
          "required": true,
          "default": {
            "input": {
              "type": "Linear",
              "in_features": 1,
              "out_features": 8
            },
            "output": {
              "type": "Linear",
              "in_features": 8,
              "out_features": 1
            }
          }
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "code",
          "type": "code",
          "default": "x = layers['input'](inputs['x'])\nx = relu(x)\nreturn layers['output'](x)"
        },
        {
          "name": "seed",
          "type": "integer",
          "default": 42,
          "min": 0,
          "max": 2147483647
        }
      ]
    },
    {
      "id": "hf.optimizer",
      "title": "Optimizer",
      "category": "Transformers \u00b7 Training",
      "description": "Optimizer recipe. Connect to Train alongside a model; AdamW updates the model's complete parameter set.",
      "inputs": [],
      "outputs": [
        {
          "name": "optimizer",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "default": "AdamW",
          "options": [
            "AdamW",
            "Adam",
            "SGD",
            "RMSprop"
          ]
        },
        {
          "name": "lr",
          "type": "number",
          "default": 0.01
        },
        {
          "name": "weight_decay",
          "type": "number",
          "default": 0
        },
        {
          "name": "momentum",
          "type": "number",
          "default": 0
        }
      ]
    },
    {
      "id": "hf.train",
      "title": "Train multi-parameter model",
      "category": "Transformers \u00b7 Training",
      "description": "Actual autograd/optimizer updates, finite loss checks, gradient clipping, measured parameter hashes and loss history.",
      "inputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "data",
          "type": "object",
          "required": true
        },
        {
          "name": "optimizer",
          "type": "object",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "metrics",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "steps",
          "type": "integer",
          "default": 20,
          "min": 1
        },
        {
          "name": "batch_size",
          "type": "integer",
          "default": 3,
          "min": 1,
          "max": 128
        },
        {
          "name": "loss",
          "type": "string",
          "default": "mse",
          "options": [
            "mse",
            "cross_entropy",
            "model"
          ]
        },
        {
          "name": "clip_grad_norm",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "id": "hf.forward",
      "title": "Forward pass",
      "category": "Transformers \u00b7 Inference",
      "description": "Run a real model forward; tensors remain in the job worker and expose shape/dtype/value previews.",
      "inputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "data",
          "type": "object",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "result",
          "type": "object",
          "required": true
        }
      ],
      "parameters": []
    },
    {
      "id": "hf.evaluate",
      "title": "Evaluate model",
      "category": "Transformers \u00b7 Inference",
      "description": "Evaluate a finite loss and optional classification accuracy without changing weights.",
      "inputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "data",
          "type": "object",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "metrics",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "loss",
          "type": "string",
          "default": "mse",
          "options": [
            "mse",
            "cross_entropy",
            "model"
          ]
        }
      ]
    },
    {
      "id": "hf.generate",
      "title": "HF generate",
      "category": "Transformers \u00b7 Inference",
      "description": "Real bounded HF autoregressive generation with attention masks and deterministic default sampling.",
      "inputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "data",
          "type": "object",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "result",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "max_new_tokens",
          "type": "integer",
          "default": 8,
          "min": 1,
          "max": 128
        },
        {
          "name": "do_sample",
          "type": "boolean",
          "default": false
        },
        {
          "name": "temperature",
          "type": "number",
          "default": 1
        }
      ]
    },
    {
      "id": "hf.pipeline",
      "title": "HF pipeline",
      "category": "Transformers \u00b7 Inference",
      "description": "Actual Transformers pipeline with a job-local model/tokenizer, offline inference and bounded inputs.",
      "inputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "tokenizer",
          "type": "object",
          "required": true
        },
        {
          "name": "texts",
          "type": "array",
          "required": true,
          "default": [
            "hello world"
          ]
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "result",
          "type": "object",
          "required": true
        }
      ],
      "parameters": [
        {
          "name": "task",
          "type": "string",
          "default": "text-generation",
          "options": [
            "text-generation",
            "text-classification",
            "token-classification",
            "fill-mask",
            "feature-extraction"
          ]
        },
        {
          "name": "max_new_tokens",
          "type": "integer",
          "default": 8,
          "min": 1,
          "max": 128
        }
      ]
    },
    {
      "id": "hf.inspect",
      "title": "Inspect model",
      "category": "Transformers \u00b7 Observe",
      "description": "Real parameter names, shapes, trainable counts, architecture, finite checks and weight hash.",
      "inputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "report",
          "type": "object",
          "required": true
        }
      ],
      "parameters": []
    },
    {
      "id": "hf.checkpoint",
      "title": "Export safe model",
      "category": "Transformers \u00b7 Artifacts",
      "description": "Immutable ZIP with safetensors weights and a declarative architecture recipe. No pickle or executable model code.",
      "inputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        },
        {
          "name": "artifact",
          "type": "object",
          "required": true
        }
      ],
      "parameters": []
    },
    {
      "id": "hf.load",
      "title": "Load safe model",
      "category": "Transformers \u00b7 Artifacts",
      "description": "Load only a registered graph artifact, verify safe ZIP/recipe/safetensors and rebuild within model budgets.",
      "inputs": [
        {
          "name": "artifact",
          "type": "object",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "model",
          "type": "object",
          "required": true
        }
      ],
      "parameters": []
    }
  ],
  "templates": [
    {
      "id": "transformers-mlp",
      "category": "Transformers",
      "graph": {
        "name": "Multi-parameter RMSNorm laboratory",
        "description": "Dense \u2192 RMSNorm \u2192 GELU \u2192 dense; real AdamW training and safe checkpoint.",
        "nodes": [
          {
            "id": "model",
            "type": "hf.sequential",
            "position": {
              "x": 30,
              "y": 30
            },
            "params": {}
          },
          {
            "id": "data",
            "type": "hf.data",
            "position": {
              "x": 30,
              "y": 330
            },
            "params": {}
          },
          {
            "id": "optimizer",
            "type": "hf.optimizer",
            "position": {
              "x": 360,
              "y": 330
            },
            "params": {}
          },
          {
            "id": "train",
            "type": "hf.train",
            "position": {
              "x": 700,
              "y": 30
            },
            "params": {}
          },
          {
            "id": "inspect",
            "type": "hf.inspect",
            "position": {
              "x": 1030,
              "y": 30
            },
            "params": {}
          },
          {
            "id": "checkpoint",
            "type": "hf.checkpoint",
            "position": {
              "x": 1360,
              "y": 30
            },
            "params": {}
          }
        ],
        "edges": [
          {
            "id": "model:model-train:model",
            "source": "model",
            "source_port": "model",
            "target": "train",
            "target_port": "model"
          },
          {
