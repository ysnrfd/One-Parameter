  "sandbox": {
    "available": true,
    "language": "javascript",
    "runtime": "V8 / mini-racer",
    "execution": "synchronous-function-body",
    "fresh_process_per_invocation": true,
    "code_limit_bytes": 65536,
    "input_limit_bytes": 1048576,
    "output_limit_bytes": 1048576,
    "max_json_depth": 64,
    "max_output_values": 500000,
    "max_output_array_length": 100000,
    "timeout_ms": {
      "min": 10,
      "max": 10000,
      "default": 1000
    },
    "memory_mb": {
      "min": 16,
      "max": 64,
      "default": 32
    },
    "wall_grace_ms": 30000,
    "worker_request_limit_bytes": 1442816,
    "windows_process_memory_mb": 256,
    "windows_process_limit": 1,
    "windows_job_active": true,
    "os_virtual_machine": false,
    "logs": {
      "max_entries": 100,
      "max_line_characters": 2048,
      "max_total_characters": 16384
    },
    "host_io": false,
    "python": false,
    "network": false,
    "filesystem": false,
    "dom": false,
    "timers": false,
    "webassembly": false,
    "numbers": "IEEE-754 binary64; nonexact integer inputs rejected; use decimal strings and BigInt for wide integers",
    "host_api": false,
    "description": "Scripts return JSON outputs. Real experiment actions use explicit built-in nodes.",
    "startup_timeout_ms": 30000,
    "execution_wall_grace_ms": 3000
  },
  "limits": {
    "graphs": 100,
    "nodes_per_graph": 500,
    "edges_per_graph": 2000,
    "plugins": 64,
    "queued_jobs": 16,
    "job_history": 50,
    "job_bytes": 8000000,
    "job_history_bytes": 24000000,
    "artifact_bytes": 8388608,
    "graph_registry_bytes": 8000000,
    "plugin_registry_bytes": 4000000,
    "graph_bytes": 2000000
  }
}
