    {"id":"architecture-checks","type":"core.script","title":"Custom script · verify native architecture","position":{"x":2000,"y":390},"params":{"code":"if (inputs.architecture !== 'LlamaForCausalLM') throw new Error('Expected native LlamaForCausalLM');\nif (inputs.parameter_count !== 78144 || inputs.parameter_tensors !== 21) throw new Error('Unexpected Llama dimensions or weights');\nconst modules = inputs.modules || [];\nfor (const type of ['LlamaDecoderLayer','LlamaAttention','LlamaMLP','LlamaRMSNorm','LlamaRotaryEmbedding']) {\n  if (!modules.some(m => m.type === type)) throw new Error('Missing native component: ' + type);\n}\nconst p = inputs.parameters;\nfor (let i = 0; i < 2; i++) {\n  for (const part of ['self_attn.q_proj.weight','self_attn.k_proj.weight','self_attn.v_proj.weight','self_attn.o_proj.weight','mlp.gate_proj.weight','mlp.up_proj.weight','mlp.down_proj.weight']) {\n    if (!p.some(t => t.name === `model.layers.${i}.${part}`)) throw new Error('Missing projection ' + part);\n  }\n}\nconsole.log('Verified actual native Llama module and tensor inventory');\nreturn {value:{verified:true,architecture:inputs.architecture,parameters:inputs.parameter_count,tensors:inputs.parameter_tensors,decoder_layers:2,query_heads:4,kv_heads:2,rope:true,normalization:'RMSNorm',feed_forward:'SwiGLU'}};","timeout_ms":1000,"memory_mb":32}},
