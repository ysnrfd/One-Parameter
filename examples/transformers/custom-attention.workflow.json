{
  "name": "Custom residual attention architecture",
  "description": "Editable embedding, RMSNorm, causal self-attention and residual addition. Train every parameter using real autograd and AdamW.",
  "nodes": [
    {
      "id": "model",
      "type": "hf.custom",
      "position": {
        "x": 20,
        "y": 20
      },
      "params": {
        "layers": {
          "embed": {
            "type": "Embedding",
            "num_embeddings": 16,
            "embedding_dim": 8
          },
          "norm": {
            "type": "RMSNorm",
            "normalized_shape": 8,
            "eps": 0.000001
          },
          "attention": {
            "type": "SelfAttention",
            "embed_dim": 8,
            "num_heads": 2,
            "dropout": 0,
            "causal": true
          },
          "output": {
            "type": "Linear",
            "in_features": 8,
            "out_features": 4
          }
        },
        "code": "h = layers['embed'](inputs['input_ids'])\na = layers['attention'](layers['norm'](h))\nh = h + a\nreturn layers['output'](h)"
      }
    },
